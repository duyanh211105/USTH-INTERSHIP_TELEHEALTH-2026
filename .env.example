# Frontend
VITE_API_URL=http://localhost:4000

# Backend
PORT=4000
JWT_SECRET=change-this-secret

# Database
# SQLite is the default local development database.
DB_CLIENT=sqlite
DB_FILE=server/data/telehealth.sqlite

# PostgreSQL is optional for production-ready deployments.
# Set DB_CLIENT=postgres and provide DATABASE_URL to use PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/telehealth

UPLOAD_DIR=server/uploads

# Optional Firebase Storage integration.
# If these values are missing, the backend automatically falls back to local storage.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket.appspot.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional OpenRouter integration for medical record AI analysis.
# Keep this key server-side only. Never expose it to the frontend.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_MAX_INPUT_CHARS=20000

# Optional PaddleOCR environment for future OCR integration.
# Keep this virtual environment local and do not commit it.
PYTHON_PATH=server/.venv-paddle/Scripts/python.exe
PADDLE_OCR_TIMEOUT_MS=60000
